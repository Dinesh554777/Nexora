# ---------------------------------------------------------------------------
# Nexora backend environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env and NEVER place real secrets in this file.
# ---------------------------------------------------------------------------

# Secret API key for future external ML/API integration (optional).
NEXORA_API_KEY=your_api_key_here

# PostgreSQL connection string used by SQLAlchemy/Alembic (required for persistence).
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
# Special characters in the password must be percent-encoded (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nexora
